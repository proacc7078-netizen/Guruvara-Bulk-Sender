# =============================================================================
# Japa Message CMS — PRODUCTION environment template
# =============================================================================
#
# ⚠️  TEMPLATE ONLY. CONTAINS NO REAL VALUES AND NO SECRETS.
#
# Copy to the application root as `.env` and fill in every <<...>> placeholder.
# `.env` is git-ignored. Never commit real values. Never paste this file into
# tickets, chat, or logs.
#
# Generate real secrets locally, e.g.:
#     node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# The development reference file is ../../.env.example (repo root). This file
# documents the production requirements only.
# -----------------------------------------------------------------------------

# --- Core runtime -----------------------------------------------------------
NODE_ENV=production
# Bind to loopback only. The reverse proxy is the sole public entry point.
# Omitting HOST leaves Express listening on ALL interfaces - do not do that.
HOST=127.0.0.1
PORT=3000

# --- Database ---------------------------------------------------------------
# MUST be absolute. Relative paths resolve against the prisma/ directory and are
# fragile. The parent directory must already exist.
#   Windows: DATABASE_URL="file:D:/japa-data/db/japa.db"
#   POSIX  : DATABASE_URL="file:/var/lib/japa/db/japa.db"
DATABASE_URL="file:<<PERSISTENT_DATA_PATH>>/db/japa.db"

# Keep 'delete' (SQLite's default). WAL was measured to break the Windows
# restore path (EBUSY: the restore renames the live DB file while SQLite holds
# the WAL mapping). Do not change this without reworking restore first.
SQLITE_JOURNAL_MODE=delete

# --- Sessions / auth --------------------------------------------------------
# REQUIRED. At least 32 characters; the process refuses to start otherwise.
# Unique per deployment. Rotating this invalidates all sessions.
SESSION_SECRET="<<GENERATE_RANDOM_64_HEX_CHARACTERS>>"
SESSION_MAX_AGE_MS=86400000
# Login brute-force protection: attempts, window, lockout (milliseconds).
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MS=900000
LOGIN_LOCKOUT_MS=900000

# --- Reverse proxy / CORS ---------------------------------------------------
# The exact public origin. Same-origin SPA + API keeps SameSite=Strict cookies
# valid. Leaving this at http://localhost:5173 makes every API call fail CORS.
CORS_ORIGIN=https://cms.example.com

# --- Media (images delivered to recipients through OpenWA) ------------------
# Must be reachable FROM OpenWA. If OpenWA runs in a container, "localhost" is
# the container, not this host.
MEDIA_PUBLIC_BASE_URL=https://cms.example.com
# REQUIRED for public media URLs. Absent => public media endpoint fails closed
# (404s); it is not a startup error.
MEDIA_PUBLIC_TOKEN_SECRET="<<GENERATE_RANDOM_64_HEX_CHARACTERS>>"

# --- WhatsApp provider: OpenWA ---------------------------------------------
# 'openwa' enables delivery. 'none' (default) or 'official' disables it.
WHATSAPP_PROVIDER=openwa
# Base URL WITHOUT the /api suffix. 'http://localhost:2785' is the dev default
# and is only correct if OpenWA really runs on this host.
WHATSAPP_OPENWA_BASE_URL=http://<<OPENWA_HOST>>:2785
# Both REQUIRED; the CMS throws WHATSAPP_CONFIGURATION_INVALID without them.
WHATSAPP_OPENWA_API_KEY="<<OPENWA_API_KEY>>"
WHATSAPP_OPENWA_SESSION_ID="<<OPENWA_SESSION_ID>>"
# HMAC-SHA256 secret for POST /api/webhooks/whatsapp/openwa.
# Unset => endpoint fails closed with 503 WEBHOOK_NOT_CONFIGURED.
WHATSAPP_OPENWA_WEBHOOK_SECRET="<<GENERATE_RANDOM_64_HEX_CHARACTERS>>"
WHATSAPP_MAX_RETRIES=3
# --- Google Sheets via Apps Script bridge ----------------------------------
# MUST be the deployed /exec URL. Never a /dev URL: that leaks the shared secret
# in source. A missing value fails only when a sync is invoked, never at startup.
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/<<DEPLOYMENT_ID>>/exec
# Must match the Apps Script Script Property named CMS_SHARED_SECRET.
GOOGLE_APPS_SCRIPT_TOKEN="<<MATCHES_APPS_SCRIPT_CMS_SHARED_SECRET>>"
# Display labels only (Settings page). Not secrets.
GOOGLE_SHEETS_SPREADSHEET_ID=<<SPREADSHEET_ID>>
GOOGLE_SHEETS_TAB_NAME=Form Responses 1

# --- Backup ----------------------------------------------------------------
# MUST be absolute and MUST live outside the replaceable application directory,
# otherwise redeploying can delete the backups.
BACKUP_DIR=<<PERSISTENT_DATA_PATH>>/backups
# FALSE BY DEFAULT - automatic backups do not run until this is true.
BACKUP_SCHEDULE_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_SCHEDULER_POLL_INTERVAL_MS=60000
# Number of newest backups kept. 0 disables retention cleanup.
BACKUP_RETENTION_COUNT=10

# --- Scheduler / queue worker ----------------------------------------------
SCHEDULER_POLL_INTERVAL_MS=60000
SCHEDULER_BATCH_SIZE=25
# Worker poll interval (ms). Default 5000.
WORKER_POLL_INTERVAL_MS=5000

# --- NOT USED in this deployment -------------------------------------------
# Meta Cloud API path. Only relevant when WHATSAPP_PROVIDER=official.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_API_BASE_URL=https://graph.facebook.com
# Meta webhook verification/signature validation. Unused with OpenWA.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# =============================================================================
# Not configurable by environment - verify these paths physically.
# =============================================================================
# Media uploads   : <app>/storage/uploads   (resolved from __dirname; there is
#                                            NO upload-directory env variable)
# Media on disk   : absolute paths stored in Media.storagePath - an existing
#                                            deployment must not be MOVED, or
#                                            every stored path breaks
# See docs/deployment/README.md section C.3 before changing any directory.
# =============================================================================