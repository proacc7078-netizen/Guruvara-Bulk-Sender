# Database Configuration
DATABASE_URL="file:./data/japa.db"

# Server Configuration
PORT=3000
# Optional bind address for the Express server. Leave unset to keep the default
# binding (all interfaces). Set to 127.0.0.1 when a reverse proxy runs on the
# same host, so the API is not directly reachable from the network.
HOST=
NODE_ENV=development

# Security
# Session configuration. The session store is memory-based (express-session
# default). Sessions are lost on server restart and are not shared between
# server processes. Use a persistent/shared session store (e.g. Redis,
# PostgreSQL) for multi-instance deployments.
# Use a unique, high-entropy value in production (at least 32 characters).
SESSION_SECRET="super_secret_session_key_change_me_in_production"
# Session lifetime in milliseconds. The default is 24 hours.
SESSION_MAX_AGE_MS=86400000
# Browser origin allowed to use authenticated API requests.
CORS_ORIGIN=http://localhost:5173
# Login brute-force protection. Values are attempts, window, and lockout in milliseconds.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MS=900000
LOGIN_LOCKOUT_MS=900000


# WhatsApp Configuration (Phase 5.2B — connection verification only, never sends messages)
# Set WHATSAPP_PROVIDER=official and provide the following to verify Meta Cloud API access.
# Credentials are read only from environment variables. Actual secrets go in local .env only.
WHATSAPP_PROVIDER=none
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_API_BASE_URL=https://graph.facebook.com
# Maximum retry attempts for a failed WhatsApp delivery. Default: 3.
WHATSAPP_MAX_RETRIES=3

# OpenWA (UNOFFICIAL WhatsApp integration, opt-in)
# Local media delivery for OpenWA containers.
# Use the host name that the OpenWA container can reach, not localhost.
# Example: http://host.docker.internal:3000
MEDIA_PUBLIC_BASE_URL=
# High-entropy secret used to sign narrowly scoped media URLs. Required for OpenWA image delivery.
MEDIA_PUBLIC_TOKEN_SECRET=

# OpenWA is a self-hosted, unofficial WhatsApp API gateway. It is NOT the
# default provider: it stays disabled unless WHATSAPP_PROVIDER is set to
# "openwa" explicitly above.
# Provider selection alone controls campaign/queue delivery:
#   WHATSAPP_PROVIDER=openwa = campaign execution and the queue worker resolve
#     the OpenWA adapter and use its existing sendText/sendMedia implementation.
#   WHATSAPP_PROVIDER=none (default) or official = OpenWA is never used.
# Never commit real values for the key or the session id; leave them empty here.
# Base URL defaults to the local OpenWA instance when unset.
WHATSAPP_OPENWA_BASE_URL=http://localhost:2785
WHATSAPP_OPENWA_API_KEY=
WHATSAPP_OPENWA_SESSION_ID=

# Phase 5.8 — WhatsApp Delivery Webhooks
# Set these to enable Meta webhook verification and signature validation.
# Without these, webhooks will return 403 (verification) or reject signatures.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Phase 7.3 — OpenWA delivery-status webhook secret (HMAC-SHA256)
# Required to enable the endpoint. When set, OpenWA must send
# X-OpenWA-Signature: sha256=<hex> matching the HMAC of the exact raw request
# body. When empty or missing, the endpoint fails closed with 503
# WEBHOOK_NOT_CONFIGURED and processes no event. Never commit a real secret.
WHATSAPP_OPENWA_WEBHOOK_SECRET=

# Phase 5.6 — persistent campaign scheduler
# How often the scheduler looks for due CampaignSchedule rows (milliseconds).
# Conservative default: 60000 (one cycle per minute).
SCHEDULER_POLL_INTERVAL_MS=60000
# Maximum number of due schedules processed per scheduler cycle.
SCHEDULER_BATCH_SIZE=25
# How often the execution queue worker polls for pending recipients, in
# milliseconds. Default: 5000. Lower values react faster but query more often.
WORKER_POLL_INTERVAL_MS=5000
# SQLite journal mode. Default: delete.
# Values: delete | wal | truncate | persist | memory | off
# Do NOT set "wal" if you use the in-app Restore feature on Windows: the restore
# replaces the database file by renaming it, and Windows refuses that rename while
# SQLite holds the WAL mapping (restore fails with EBUSY). Use "delete" (the
# default) unless restore is performed with the server stopped.
SQLITE_JOURNAL_MODE=delete

# Phase 5.12 — Backup & Recovery (local-first, no cloud provider)
# Directory for backup archives. Relative paths are resolved against the repo root.
# Default: storage/backups
BACKUP_DIR=storage/backups
# Automatic backups. Disabled by default; set to true to enable the backup scheduler.
BACKUP_SCHEDULE_ENABLED=false
# Interval between automatic backups, in hours. Default: 24.
BACKUP_INTERVAL_HOURS=24
# How often the backup scheduler checks whether a backup is due (milliseconds).
# This only controls the check granularity, not the backup interval. Default: 60000.
BACKUP_SCHEDULER_POLL_INTERVAL_MS=60000
# Number of newest backups to keep. 0 disables retention cleanup. Default: 10.
BACKUP_RETENTION_COUNT=10

# Phase 6.0B — Google Sheets manual sync via Apps Script bridge (no Google Cloud billing).
# The Sheet stays PRIVATE; the owner's Apps Script Web App reads it and the CMS
# calls that Web App with a shared secret. Never commit real values.
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_TOKEN=
# Optional display labels for Settings (no secrets here).
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB_NAME=Form Responses 1